# Public frontend configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public analytics identifiers (leave blank to disable the integration)
VITE_GTM_ID=
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=
VITE_META_PIXEL_ID=

# Public website URL
VITE_SITE_URL=https://www.ristorantealgobbodirialto.it

# Supabase Edge Function Secrets (reference only). Upload production values
# with `npx supabase secrets set --env-file <ignored-file>`; do not configure
# them as frontend hosting variables and never prefix them with VITE_.
RESEND_API_KEY=
SITE_URL=https://www.ristorantealgobbodirialto.it
RESERVATIONS_EMAIL=reservations@ristorantealgobbodirialto.it
REMINDER_CRON_SECRET=

# Meta WhatsApp Cloud API. Store production values as Supabase Function
# Secrets; they must never use the VITE_ prefix.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v26.0
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TEMPLATE_RESERVATION_CONFIRMED=reservation_confirmed
META_WHATSAPP_TEMPLATE_RESERVATION_UPDATED=reservation_updated
META_WHATSAPP_TEMPLATE_RESERVATION_CANCELLED=reservation_cancelled
META_WHATSAPP_TEMPLATE_REMINDER_24H=reservation_reminder_24h
META_WHATSAPP_TEMPLATE_REMINDER_2H=reservation_reminder_2h

# One-time admin bootstrap script. Keep these only in an ignored local file;
# they are not frontend hosting variables. Supabase provides SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY automatically to deployed Edge Functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
