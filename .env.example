# Public frontend configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public analytics identifiers. Google Ads values below configure the active
# booking conversion; leave the optional GTM, GA4, and Meta IDs blank to disable them.
