VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=AW-667133835
VITE_GOOGLE_ADS_CONVERSION_LABEL=q860CM7NluwcEIvPjr4C
VITE_META_PIXEL_ID=

# Public website and API URLs
VITE_SITE_URL=https://www.ristorantealgobbodirialto.it
VITE_API_BASE_URL=http://localhost:3000

# Server-only secrets. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://www.ristorantealgobbodirialto.it
