ALLOWED_ORIGINS=https://www.ristorantealgobbodirialto.it,http://localhost:5173,http://127.0.0.1:5173
REMINDER_CRON_SECRET=
ADMIN_ALERT_CRON_SECRET=

# Meta WhatsApp Cloud API. Store production values as Supabase Function
# Secrets; they must never use the VITE_ prefix.
